# Compose interpolation / PUBLIC build settings only. Copy to .env.
COMPOSE_PROJECT_NAME=eco-mentors-rehearsal
PLATFORM=linux/amd64
RELEASE=replace-with-full-git-sha
APP_ENV=staging
DOMAIN=mentors.example.invalid
FRONTEND_PORT=13000
UMAMI_PORT=18185
NEXT_PUBLIC_CAPTCHA_PROVIDER=smartcaptcha
NEXT_PUBLIC_SMARTCAPTCHA_CLIENT_KEY=replace-with-public-client-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=replace-with-new-website-id
NEXT_PUBLIC_S3_STORAGE_ENDPOINT=s3.storage:3900
NEXT_PUBLIC_S3_STORAGE_BUCKET=eco-mentors-media
