APP_ENV=staging
PORT=8081
BASE_URL=https://mentors.example.invalid
ALLOWED_CORS_ORIGINS=https://mentors.example.invalid
DATABASE_URL=postgres://om_api:REPLACE@postgres:5432/eco_mentors?sslmode=disable
JWT_SECRET=REPLACE
INTERNAL_MENTORS_API=REPLACE
MENTORS_API_LIST_AUTH_TOKEN=REPLACE
WORKER_AUTH_TOKEN=REPLACE_SAME_IN_WORKER
DEMO_AUTH_ENABLED=false
COOKIE_SECURE=true
COOKIE_DOMAIN=mentors.example.invalid
CAPTCHA_PROVIDER=smartcaptcha
SMARTCAPTCHA_SERVER_KEY=REPLACE
SMARTCAPTCHA_EXPECTED_HOSTNAME=mentors.example.invalid
TURNSTILE_SECRET_KEY=
