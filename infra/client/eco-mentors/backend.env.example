S3_STORAGE_SECRET_KEY=REPLACE
S3_STORAGE_ENDPOINT=http://s3.storage:3900
S3_STORAGE_BUCKET=eco-mentors-media
S3_STORAGE_REGION=garage
ANALYTICS_PROVIDER=none
POSTHOG_ENABLED=false
O11Y_EXPORTER_ENDPOINT=
O11Y_PROFILING_ENABLED=false
