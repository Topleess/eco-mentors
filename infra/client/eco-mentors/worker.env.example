APP_ENV=staging
BASE_URL=https://mentors.example.invalid
DATABASE_URL=postgres://om_worker:REPLACE@postgres:5432/eco_mentors?sslmode=disable
WORKER_PORT=8090
WORKER_DB_MAX_CONNS=5
WORKER_CRON_ENABLED=false
WORKER_REQUEST_EMAIL_RETRY_ENABLED=false
# WARNING: opt-in permits non-production retries to email real people; override wins.
WORKER_REQUEST_EMAIL_LIVE_RECIPIENTS=false
WORKER_AUTH_TOKEN=REPLACE_SAME_IN_BACKEND
SES_REGION=ru-central1
SES_ENDPOINT=https://postbox.cloud.yandex.net
SES_ACCESS_KEY_ID=REPLACE
SES_SECRET_ACCESS_KEY=REPLACE
SES_FROM_EMAIL=notifications@example.invalid
SES_FROM_NAME=Eco Mentors
MODERATORS_EMAIL=moderators@example.invalid
DEV_EMAIL_OVERRIDE=
ANALYTICS_PROVIDER=none
POSTHOG_ENABLED=false
O11Y_EXPORTER_ENDPOINT=
O11Y_PROFILING_ENABLED=false
