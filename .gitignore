# dependencies & build artifacts
node_modules/
.next/
out/
dist/
bin/
coverage/
coverage.out
*.tsbuildinfo

# secrets — never commit real env files (templates are *.example)
.env
.env.*
!.env.example
!.env.*.example
local.settings.json
# Private keys and local database exports are never publication artifacts.
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
*.sqlite
*.sqlite3
*.db
*.dump
*.backup

# logs & runtime
logs/
*.log

# OS / editor junk
.DS_Store
Thumbs.db

# Python bytecode from infra/alloy-redaction-behavior.py
__pycache__/
*.pyc
